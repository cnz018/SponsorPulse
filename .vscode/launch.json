{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SponsorPulse - Blazor Server (Firefox)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/SponsorPulse/bin/Debug/net10.0/SponsorPulse.dll",
            "args": [],
            "cwd": "${workspaceFolder}/SponsorPulse",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:7290"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/SponsorPulse/Views"
            },
            "console": "integratedTerminal"
        },
        {
            "name": ".NET Core Launch (web)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/SponsorPulse/bin/Debug/net10.0/SponsorPulse.dll",
            "args": [],
            "cwd": "${workspaceFolder}/SponsorPulse",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/SponsorPulse/Views"
            }
        },
        {
            "name": "C#: SponsorPulse [Default Configuration]",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}\\SponsorPulse\\SponsorPulse.csproj"
        }
    ]
}