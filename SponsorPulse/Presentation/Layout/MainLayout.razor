@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar-container">
        <NavMenu />
    </div>

    <main class="main-layout-content gradient-mesh">
        <LumexToastProvider @rendermode="@RenderMode.InteractiveServer" />
        @Body
    </main>
</div>

<style>
    .page {
        display: grid;
        grid-template-columns: 260px 1fr;
        grid-template-rows: 100vh 1fr;
        grid-template-areas: "sidebar main"
            "footer footer";
        min-height: 100dvh;
        background: radial-gradient(circle at top right, var(--ink-black) 0%, var(--deep-space-blue) 100%);
        color: var(--white);
    }

    .sidebar-container {
        grid-area: sidebar;
        width: 260px;

        background: var(--ink-black);
        backdrop-filter: blur(12px);
        border-right: 1px solid var(--glass-border);
        display: flex;
        flex-direction: column;
        z-index: 10;
    }

    .main-layout-content {
        grid-area: main;
        overflow-y: auto;
        padding: 32px;
        /* main_content_padding from spec */
    }
</style>