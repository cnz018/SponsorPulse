@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar-container">
        <NavMenu />
    </div>

    <main class="main-layout-content">
        @Body
    </main>
</div>

<style>
    .page {
        display: flex;
        min-height: 100vh;
        background: radial-gradient(circle at top right, var(--deep-space-blue) 0%, var(--ink-black) 100%);
        color: var(--white);
    }

    .sidebar-container {
        width: 260px;
        flex-shrink: 0;
        background: rgba(12, 24, 33, 0.8);
        backdrop-filter: blur(12px);
        border-right: 1px solid var(--glass-border);
        display: flex;
        flex-direction: column;
        z-index: 10;
    }

    .main-layout-content {
        flex: 1;
        overflow-y: auto;
        padding: 32px; /* main_content_padding from spec */
    }
</style>
