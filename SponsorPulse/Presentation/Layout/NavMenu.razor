@using SponsorPulse.Presentation.Components
@using Microsoft.AspNetCore.Identity
@using SponsorPulse.Domain.Entities
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<aside class="app-sidebar" role="navigation" aria-label="Main navigation">
    
    <!-- BRAND SECTION -->
    <div class="nav-brand">
        <BrandLogo />
    </div>

    <!-- USER PROFILE SECTION (Conditionnelle) -->
    @if (CurrentUser is not null)
    {
        <div class="user-profile-section">
            <div class="user-profile">
                <div class="user-info">
                    <LumexAvatar Size="@Size.Large" 
                                 Src="@GetUserInitials()" 
                                 Radius="@Radius.Small"
                                 aria-label="@((CurrentUser.FirstName ?? "User") + "'s avatar")" />
                    
                    <div class="user-details">
                        <p class="user-name" title="@(CurrentUser.FirstName ?? "User")">
                            @(CurrentUser.FirstName ?? "User")
                        </p>
                        <p class="user-org font-italic" title="@(CurrentUser.OrganizationName ?? "No organization")">
                            @(CurrentUser.OrganizationName ?? "No organization")
                        </p>
                        <p class="user-status">
                            <span class="status-indicator"></span>Online
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- NAVIGATION LINKS SECTION -->
    <nav class="nav-items" role="menu">
        <div class="nav-item-wrapper">
            <LumexLink Href="/dashboard" 
                       Class="@GetNavClass("/dashboard")" 
                       role="menuitem"
                       aria-current="@(IsActive("/dashboard") ? "page" : null)">
                <i class="bi bi-house nav-icon"></i>
                <span>Dashboard</span>
            </LumexLink>
        </div>

        <div class="nav-item-wrapper">
            <LumexLink Href="/settings" 
                       Class="@GetNavClass("/settings")" 
                       role="menuitem"
                       aria-current="@(IsActive("/settings") ? "page" : null)">
                <i class="bi bi-gear nav-icon"></i>
                <span>Settings</span>
            </LumexLink>
        </div>
    </nav>

    <!-- FOOTER SECTION (Logout) -->
    <div class="nav-footer">
        <div class="nav-item-wrapper">
            <button class="logout-btn" @onclick="HandleLogout" aria-label="Sign out of your account" title="Sign out">
                <i class="bi bi-box-arrow-right nav-icon"></i>
                <span>Logout</span>
            </button>
        </div>
    </div>
</aside>

