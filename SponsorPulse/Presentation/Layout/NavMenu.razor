@using SponsorPulse.Presentation.Components
@using Microsoft.AspNetCore.Identity
@using SponsorPulse.Domain.Entities
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<aside class="app-sidebar" role="navigation" aria-label="Main navigation">
    
    <!-- BRAND SECTION -->
    <div class="nav-brand">
        <BrandLogo />
    </div>

    <!-- USER PROFILE SECTION (Conditionnelle) -->
    @if (CurrentUser is not null)
    {
        <div class="user-profile-section">
            <div class="user-profile">
                <div class="user-info">
                    <LumexAvatar Size="@Size.Large" 
                                 Src="@GetUserInitials()" 
                                 Radius="@Radius.Small"
                                 aria-label="@((CurrentUser.FirstName ?? "User") + "'s avatar")" />
                    
                    <div class="user-details">
                        <p class="user-name" title="@(CurrentUser.FirstName ?? "User")">
                            @(CurrentUser.FirstName ?? "User")
                        </p>
                        <p class="user-org font-italic" title="@(CurrentUser.OrganizationName ?? "No organization")">
                            @(CurrentUser.OrganizationName ?? "No organization")
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- NAVIGATION LINKS SECTION -->
    <nav class="nav-items" role="menu">
        <div class="nav-item-wrapper">
            <LumexLink Href="/dashboard" 
                       Class="@GetNavClass("/dashboard")" 
                       role="menuitem"
                       aria-current="@(IsActive("/dashboard") ? "page" : null)">
                <i class="bi bi-house nav-icon"></i>
                <span>Dashboard</span>
            </LumexLink>
        </div>

        <div class="nav-item-wrapper">
            <LumexLink Href="/settings" 
                       Class="@GetNavClass("/settings")" 
                       role="menuitem"
                       aria-current="@(IsActive("/settings") ? "page" : null)">
                <i class="bi bi-gear nav-icon"></i>
                <span>Settings</span>
            </LumexLink>
        </div>
    </nav>

    <!-- FOOTER SECTION (Logout) -->
    <div class="nav-footer">
        <div class="nav-item-wrapper">
            <button class="logout-btn" @onclick="HandleLogout" aria-label="Sign out of your account" title="Sign out">
                <i class="bi bi-box-arrow-right nav-icon"></i>
                <span>Logout</span>
            </button>
        </div>
    </div>
</aside>




@code {
    private ApplicationUser? CurrentUser;

    protected override async Task OnInitializedAsync()
    {
        @* var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var claimsPrincipal = authState.User;

        if (claimsPrincipal?.Identity?.IsAuthenticated == true)
        {
            var userId = claimsPrincipal.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (!string.IsNullOrEmpty(userId))
            {
                CurrentUser = await UserManager.FindByIdAsync(userId);
            }
        } *@

        CurrentUser = await UserManager.FindByEmailAsync("testchris@sp.test.com");
    }

    private bool IsActive(string path)
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (string.IsNullOrEmpty(currentPath))
        {
            currentPath = "/";
        }
        else
        {
            currentPath = "/" + currentPath;
        }

        return currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
    }

    private async Task HandleLogout()
    {
        await SignInManager.SignOutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private string GetNavClass(string path)
    {
        return $"{(IsActive(path) ? "active" : "")}";
    }

    private string GetUserInitials()
    {
        if (CurrentUser == null) return "";
        var initials = "";
        if (!string.IsNullOrEmpty(CurrentUser.FirstName))
            initials += CurrentUser.FirstName[0];
        if (!string.IsNullOrEmpty(CurrentUser.LastName))
            initials += CurrentUser.LastName[0];
        return initials.ToUpper();
    }
}
