<LumexNavbar>
    <LumexUser Name="John Doe" Description="Paternship Manager">
        <AvatarContent>
            <LumexAvatar Src="https://randomuser.me/api/portraits/" Radius=@Radius.Small />
        </AvatarContent>
    </LumexUser>
    <LumexDivider />
    <LumexNavbarItem>
        <LumexLink href="" class="nav-item mb-auto">
            <i class="bi bi-house mr-2"></i> Dashboard
        </LumexLink>
    </LumexNavbarItem>
    <LumexNavbarItem>
        <LumexLink href="" class="nav-item mb-auto">
            <i class="bi bi-gear mr-2"></i> Settings
        </LumexLink>
    </LumexNavbarItem>
</LumexNavbar>

<style>
    nav {
        display: flex;
        flex-direction: column;
    }

    .logo-area {
        display: flex;
        padding: 2rem;
        margin-bottom: 1rem;
    }

    .logo-area img {
        width: 32px;
        height: 32px;
        margin-right: 8px;
    }

    .logo-nav {
        font-size: 1.5rem;
        font-weight: 700;
        background: var(--white);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .nav-item {
        display: flex;
        align-items: center;
        padding: 0.75rem 2rem;
        color: var(--grey-text);
        text-decoration: none;
        transition: all 0.2s;
        border-left: 3px solid transparent;
        margin-bottom: 4px;
    }

    .nav-item:hover {
        background: var(--glass-bg);
        color: var(--white);
    }

    .nav-item.active {
        background: var(--glass-bg);
        color: var(--white);
        border-left-color: #10B981;
        /* Green accent from spec */
    }

    .icon {
        margin-right: 12px;
        font-size: 1.1rem;
        width: 1.25rem;
        height: 1.25rem;
        border: 1px solid var(--grey-text);
        border-radius: 4px;
        display: inline-block;
    }
</style>