@using SponsorPulse.Domain.Entities

<div class="event-selector-container">
    <!-- Toolbar avec actions groupées -->
    @if (SelectedEventIds.Count > 1)
    {
        <div class="toolbar-grouped-actions glass-panel mb-4">
            <div class="toolbar-info">
                <span class="text-sm text-gray-400">
                    @SelectedEventIds.Count événement(s) sélectionné(s)
                </span>
            </div>
            <div class="toolbar-actions gap-2 flex">
                <button class="btn-grouped" @onclick="() => OnBulkAnalyze.InvokeAsync()">
                    Analyser les sélectionnés
                </button>
                <button class="btn-grouped btn-danger" @onclick="() => OnBulkDelete.InvokeAsync()">
                    Supprimer les sélectionnés
                </button>
            </div>
        </div>
    }

    <!-- Tableau des événements -->
    <div class="events-table glass-panel">
        @if (Events == null || !Events.Any())
        {
            <div class="text-center text-gray-400 py-8">
                Aucun événement pour le moment.
            </div>
        }
        else
        {
            <table class="w-full">
                <thead>
                    <tr class="border-b border-gray-700">
                        <th class="checkbox-col">
                            <input type="checkbox"    @onchange="ToggleSelectAll"                   checked="@IsAllSelected"
                                   class="checkbox-input" />
                        </th>
                        <th class="col-name">Événement</th>
                        <th class="col-date">Date</th>
                        <th class="col-platform">Plateforme</th>
                        <th class="col-status">Statut</th>
                        <th class="col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evt in Events)
                    {
                        <tr class="@GetRowClass(evt.Id)" @onclick="() => ToggleSelection(evt.Id, null)">
                            <td class="checkbox-col">
                                <input type="checkbox"
                                       @onchange="(ChangeEventArgs e) => ToggleSelection(evt.Id, (bool)e.Value!)"
                                       @onclick:stopPropagation="true"           checked="@IsEventSelected(evt.Id)"          class="checkbox-input" />
                            </td>
                            <td class="col-name">
                                <div class="event-name">@evt.Name</div>
                            </td>
                            <td class="col-date">
                                <span class="text-gray-400">@evt.Date.ToShortDateString()</span>
                            </td>
                            <td class="col-platform">
                                <span class="platform-badge">@evt.StreamPlatform</span>
                            </td>
                            <td class="col-status">
                                <span class="@GetStatusClass(evt.Status)">@evt.Status</span>
                            </td>
                            <td class="col-actions">
                                <div class="relative">
                                    <button class="btn-menu"                title="Options"                    @onclick="() => ToggleMenu(evt.Id)"
                                            @onclick:stopPropagation="true">
                                        <svg class="icon-dots" viewBox="0 0 24 24" fill="currentColor">
                                            <circle cx="12" cy="5" r="2" />
                                            <circle cx="12" cy="12" r="2" />
                                            <circle cx="12" cy="19" r="2" />
                                        </svg>
                                    </button>

                                    @if (OpenMenuId == evt.Id)
                                    {
                                        <div class="menu-dropdown" @onclick:stopPropagation="true">
                                            <button class="menu-item" @onclick="() => OnEdit.InvokeAsync(evt)">
                                                <span class="icon-edit">✎</span> Éditer
                                            </button>
                                            <button class="menu-item" @onclick="() => OnAnalyze.InvokeAsync(evt)">
                                                <span class="icon-analyze">📊</span> Analyser
                                            </button>
                                            <button class="menu-item" @onclick="() => OnGenerate.InvokeAsync(evt)">
                                                <span class="icon-generate">📄</span> Générer PDF
                                            </button>
                                            <hr class="menu-divider" />
                                            <button class="menu-item danger" @onclick="() => OnDelete.InvokeAsync(evt)">
                                                <span class="icon-delete">🗑</span> Supprimer
                                            </button>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<style>
    .event-selector-container {
        width: 100%;
    }

    .toolbar-grouped-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem;
        border-radius: 12px;
        background: rgba(59, 130, 246, 0.05);
        border: 1px solid rgba(59, 130, 246, 0.2);
        animation: slideDownAnimation 0.2s ease-out;
    }

    @@keyframes slideDownAnimation {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .toolbar-info {
        flex: 1;
    }

    .toolbar-actions {
        display: flex;
    }

    .events-table {
        border-radius: 12px;
        background: rgba(30, 41, 59, 0.3);
        border: 1px solid rgba(148, 163, 184, 0.2);
        overflow: hidden;
    }

    table {
        border-collapse: collapse;
    }

    thead {
        background: rgba(0, 0, 0, 0.2);
    }

    th {
        text-align: left;
        padding: 1rem;
        font-weight: 600;
        color: var(--grey-text);
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    tbody tr {
        border-bottom: 1px solid rgba(148, 163, 184, 0.1);
        transition: background 0.2s;
        cursor: pointer;
    }

    tbody tr:hover {
        background: rgba(255, 255, 255, 0.03);
    }

    tbody tr.selected {
        background: rgba(59, 130, 246, 0.1);
    }

    td {
        padding: 1rem;
        color: var(--white);
        font-size: 0.95rem;
    }

    .checkbox-col {
        width: 50px;
        text-align: center;
    }

    .col-name {
        width: 35%;
    }

    .col-date {
        width: 15%;
    }

    .col-platform {
        width: 12%;
    }

    .col-status {
        width: 15%;
    }

    .col-actions {
        width: 8%;
        text-align: center;
    }

    .checkbox-input {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: var(--lavender);
    }

    .event-name {
        font-weight: 500;
        color: var(--white);
    }

    .platform-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: rgba(148, 163, 184, 0.2);
        border-radius: 4px;
        font-size: 0.8rem;
        color: var(--grey-text);
    }

    .status-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .status-badge.Draft {
        background: rgba(107, 114, 128, 0.2);
        color: #9CA3AF;
    }

    .status-badge.Fetching {
        background: rgba(59, 130, 246, 0.2);
        color: #60A5FA;
    }

    .status-badge.AnalysisReady {
        background: rgba(34, 197, 94, 0.2);
        color: #86EFAC;
    }

    .status-badge.Completed {
        background: rgba(168, 85, 247, 0.2);
        color: #D8B4FE;
    }

    .status-badge.Error {
        background: rgba(239, 68, 68, 0.2);
        color: #FCA5A5;
    }

    .btn-menu {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--grey-text);
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        padding: 0;
    }

    .btn-menu:hover {
        background: rgba(255, 255, 255, 0.05);
        color: var(--lavender);
        border-color: var(--lavender);
    }

    .icon-dots {
        width: 16px;
        height: 16px;
    }

    .menu-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        margin-top: 2px;
        background: var(--dark-bg);
        border: 1px solid rgba(148, 163, 184, 0.2);
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
        z-index: 20;
        min-width: 180px;
        overflow: hidden;
    }

    .menu-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        width: 100%;
        text-align: left;
        padding: 0.75rem 1rem;
        background: transparent;
        border: none;
        color: var(--grey-text);
        cursor: pointer;
        font-size: 0.9rem;
        transition: all 0.2s;
    }

    .menu-item:hover {
        background: rgba(255, 255, 255, 0.05);
        color: var(--white);
    }

    .menu-item.danger:hover {
        background: rgba(239, 68, 68, 0.15);
        color: #FCA5A5;
    }

    .menu-divider {
        margin: 0.5rem 0;
        border: none;
        border-top: 1px solid rgba(148, 163, 184, 0.1);
    }

    .btn-grouped {
        padding: 0.5rem 1rem;
        background: rgba(59, 130, 246, 0.2);
        border: 1px solid rgba(59, 130, 246, 0.4);
        color: #60A5FA;
        border-radius: 6px;
        font-weight: 500;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-grouped:hover {
        background: rgba(59, 130, 246, 0.4);
        border-color: #60A5FA;
    }

    .btn-grouped.btn-danger {
        background: rgba(239, 68, 68, 0.2);
        border-color: rgba(239, 68, 68, 0.4);
        color: #FCA5A5;
    }

    .btn-grouped.btn-danger:hover {
        background: rgba(239, 68, 68, 0.4);
        border-color: #FCA5A5;
    }

    .flex {
        display: flex;
    }

    .gap-2 {
        gap: 0.5rem;
    }

    .mb-4 {
        margin-bottom: 1rem;
    }

    .py-8 {
        padding: 2rem 0;
    }

    .text-gray-400 {
        color: var(--grey-text);
    }

    .text-white {
        color: var(--white);
    }

    .text-sm {
        font-size: 0.875rem;
    }

    .text-center {
        text-align: center;
    }

    .relative {
        position: relative;
    }

    .w-full {
        width: 100%;
    }
</style>

@code {
    [Parameter]
    public List<Event>? Events { get; set; }

    [Parameter]
    public EventCallback<Event> OnEdit { get; set; }

    [Parameter]
    public EventCallback<Event> OnDelete { get; set; }

    [Parameter]
    public EventCallback<Event> OnAnalyze { get; set; }

    [Parameter]
    public EventCallback<Event> OnGenerate { get; set; }

    [Parameter]
    public EventCallback OnBulkAnalyze { get; set; }

    [Parameter]
    public EventCallback OnBulkDelete { get; set; }

    private HashSet<Guid> SelectedEventIds { get; set; } = new();
    private Guid? OpenMenuId { get; set; }

    private void ToggleSelection(Guid eventId, bool? isChecked)
    {
        if (isChecked.HasValue)
        {
            if (isChecked.Value)
            {
                SelectedEventIds.Add(eventId);
            }
            else
            {
                SelectedEventIds.Remove(eventId);
            }
        }
        else if (!SelectedEventIds.Contains(eventId))
        {
            SelectedEventIds.Add(eventId);
        }
        else
        {
            SelectedEventIds.Remove(eventId);
        }
        StateHasChanged();
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if ((bool)e.Value!)
        {
            SelectedEventIds.Clear();
            foreach (var evt in Events ?? new())
            {
                SelectedEventIds.Add(evt.Id);
            }
        }
        else
        {
            SelectedEventIds.Clear();
        }
        StateHasChanged();
    }

    private bool IsAllSelected => Events?.Any() == true && SelectedEventIds.Count == Events.Count;

    private bool IsEventSelected(Guid eventId) => SelectedEventIds.Contains(eventId);

    private string GetRowClass(Guid eventId) => IsEventSelected(eventId) ? "selected" : "";

    private void ToggleMenu(Guid eventId)
    {
        OpenMenuId = OpenMenuId == eventId ? null : eventId;
    }

    private string GetStatusClass(EventStatus status) =>
        $"status-badge {status.ToString()}";
}