@layout EmptyLayout
@page "/login"
@rendermode RenderMode.InteractiveServer
@using Microsoft.AspNetCore.Identity
@using SponsorPulse.Presentation.Components
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Navigation



<PageTitle>Connexion - SponsorPulse</PageTitle>

<div class="min-h-screen gradient-mesh font-jakarta">
    <!-- Navbar avec BrandLogo -->
    <LumexNavbar Sticky="@false" Blurred="@false" Bordered="@false" Height="5rem" Class="login-navbar">
        <LumexNavbarBrand>
            <div @onclick="GoHome" style="cursor: pointer;">
                <BrandLogo />
            </div>
        </LumexNavbarBrand>
    </LumexNavbar>

    <!-- Main Auth Content -->
    <div class="auth-container">
        <!-- Décor Background -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div class="absolute top-20 left-10 w-72 h-72 bg-red-500/5 rounded-full blur-3xl"></div>
            <div class="absolute bottom-20 right-10 w-96 h-96 bg-purple-500/5 rounded-full blur-3xl"></div>
        </div>

        <!-- Auth Card -->
        <div class="auth-card">
            <div class="auth-header">
                <h1 class="auth-title">Se connecter</h1>
                <p class="auth-subtitle">Accédez à votre tableau de bord SponsorPulse</p>
            </div>

            @if (!string.IsNullOrEmpty(loginError))
            {
                <div class="auth-error">
                    <span>@loginError</span>
                </div>
            }

            @if (!ShowRegister)
            {
                <form method="post" action="/auth/login" class="auth-form">
                    <AntiforgeryToken />

                    <div class="form-group">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" id="email" name="email" class="form-input-styled" placeholder="vous@exemple.com"
                               @bind-value="loginModel.Email" />
                    </div>

                    <div class="form-group">
                        <label for="password" class="form-label">Mot de passe</label>
                        <div class="form-input-wrapper">
                            <input type="@(showLoginPassword ? "text" : "password")" id="password" name="password"
                                   class="form-input-styled" placeholder="••••••••" @bind-value="loginModel.Password" />
                            <button type="button" class="password-toggle"
                                    @onclick="() => showLoginPassword = !showLoginPassword"
                                    title="Afficher/Masquer le mot de passe">
                                @if (showLoginPassword)
                                {
                                    <img src="https://api.iconify.design/ic:outline-visibility-off.svg" alt="Masquer"
                                         class="toggle-icon" />
                                }
                                else
                                {
                                    <img src="https://api.iconify.design/ic:outline-visibility.svg" alt="Afficher"
                                         class="toggle-icon" />
                                }
                            </button>
                        </div>
                    </div>

                    <div class="form-checkbox">
                        <input type="checkbox" id="remember" name="rememberMe" class="form-checkbox"
                               @bind-value="loginModel.RememberMe" />
                        <label for="remember" class="form-checkbox-label">Se souvenir de moi</label>
                    </div>

                    <LumexButton class="btn-primary w-full" Type="ButtonType.Submit" Variant="@Variant.Ghost">
                        Se connecter
                    </LumexButton>
                </form>
            }
            else
            {
                <form method="post" action="/auth/register" class="auth-form">
                    <AntiforgeryToken />

                    <div class="form-group">
                        <label for="register-firstname" class="form-label">Nom</label>
                        <input type="text" id="register-firstname" name="firstName" class="form-input-styled"
                               placeholder="John Streets" @bind-value="registerModel.FirstName" />
                    </div>

                    <div class="form-group">
                        <label for="register-orgname" class="form-label">Nom de l'organisation</label>
                        <input type="text" id="register-orgname" name="organizationName" class="form-input-styled"
                               placeholder="Hyper Gaming Core" @bind-value="registerModel.OrganizationName" />
                    </div>

                    <div class="form-group">
                        <label for="register-email" class="form-label">Email</label>
                        <input type="email" id="register-email" name="email" class="form-input-styled"
                               placeholder="vous@exemple.com" @bind-value="registerModel.Email" />
                    </div>

                    <div class="form-group">
                        <label for="register-password" class="form-label">Mot de passe</label>
                        <div class="form-input-wrapper">
                            <input type="@(showRegisterPassword ? "text" : "password")" id="register-password"
                                   name="password" class="form-input-styled" placeholder="••••••••"
                                   @bind-value="registerModel.Password" />
                            <button type="button" class="password-toggle"
                                    @onclick="() => showRegisterPassword = !showRegisterPassword"
                                    title="Afficher/Masquer le mot de passe">
                                @if (showRegisterPassword)
                                {
                                    <img src="https://api.iconify.design/ic:outline-visibility-off.svg" alt="Masquer"
                                         class="toggle-icon" />
                                }
                                else
                                {
                                    <img src="https://api.iconify.design/ic:outline-visibility.svg" alt="Afficher"
                                         class="toggle-icon" />
                                }
                            </button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="confirm-password" class="form-label">Confirmer le mot de passe</label>
                        <div class="form-input-wrapper">
                            <input type="@(showConfirmPassword ? "text" : "password")" id="confirm-password"
                                   name="confirmPassword" class="form-input-styled" placeholder="••••••••"
                                   @bind-value="registerModel.ConfirmPassword" />
                            <button type="button" class="password-toggle"
                                    @onclick="() => showConfirmPassword = !showConfirmPassword"
                                    title="Afficher/Masquer le mot de passe">
                                @if (showConfirmPassword)
                                {
                                    <img src="https://api.iconify.design/ic:outline-visibility-off.svg" alt="Masquer"
                                         class="toggle-icon" />
                                }
                                else
                                {
                                    <img src="https://api.iconify.design/ic:outline-visibility.svg" alt="Afficher"
                                         class="toggle-icon" />
                                }
                            </button>
                        </div>
                    </div>

                    <LumexButton class="btn-primary w-full" Type="ButtonType.Submit" Variant="@Variant.Ghost">
                        Créer un compte
                    </LumexButton>
                </form>
            }
        </div>
        <div class="auth-divider">
            <span>Nouveau sur SponsorPulse ?</span>
        </div>

        <LumexButton class="btn-secondary w-full" Variant="@Variant.Ghost"
                     @onclick="() => ShowRegister = !ShowRegister">
            @if (ShowRegister)
            {
                <span>Masquer le formulaire d'inscription</span>
            }
            else
            {
                <span>Créer un compte</span>
            }
        </LumexButton>
    </div>
</div>

@code {
    public bool ShowRegister { get; set; } = false;
    private bool showLoginPassword = false;
    private bool showRegisterPassword = false;
    private bool showConfirmPassword = false;
    private string? loginError = null;
    private string? registerError = null;

    public class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public bool RememberMe { get; set; }
    }

    public class RegisterModel
    {
        public string FirstName { get; set; } = string.Empty;
        public string OrganizationName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    [Parameter]
    public string? Error { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Error))
        {
            loginError = Error switch
            {
                "invalid_credentials" => "Identifiants invalides",
                "locked_out" => "Compte verrouillé",
                "password_mismatch" => "Les mots de passe ne correspondent pas",
                _ => "Une erreur est survenue"
            };
        }
    }

    private LoginModel loginModel = new();
    private RegisterModel registerModel = new();

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
}

<style>
    .auth-container {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 5rem);
        padding: 2rem;
    }

    .auth-card {
        position: relative;
        z-index: 10;
        background: rgba(13, 15, 23, 0.6);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 12px;
        padding: 2.5rem;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }

    .auth-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .auth-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--white);
        margin-bottom: 0.5rem;
    }

    .auth-subtitle {
        font-size: 0.875rem;
        color: var(--slate-400);
    }

    .auth-error {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #fca5a5;
        padding: 0.75rem 1rem;
        border-radius: 6px;
        margin-bottom: 1.5rem;
        font-size: 0.875rem;
    }

    .auth-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-label {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--white);
    }

    .form-input-styled {
        background: rgba(51, 65, 85, 0.5);
        border: 1px solid rgba(148, 163, 184, 0.2);
        color: var(--white);
        padding: 0.75rem 1rem;
        border-radius: 6px;
        font-size: 0.875rem;
        transition: all 0.2s ease;
    }

    .form-input-styled:hover {
        border-color: rgba(148, 163, 184, 0.4);
        background: rgba(51, 65, 85, 0.7);
    }

    .form-input-styled:focus {
        outline: none;
        border-color: rgba(148, 163, 184, 0.6);
        background: rgba(51, 65, 85, 0.9);
        box-shadow: 0 0 0 3px rgba(148, 163, 184, 0.1);
    }

    .form-input-styled::placeholder {
        color: rgba(148, 163, 184, 0.6);
    }

    .form-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .form-input-wrapper input {
        flex: 1;
    }

    .password-toggle {
        position: absolute;
        right: 0.75rem;
        background: none;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0.6;
        transition: opacity 0.2s ease;
    }

    .password-toggle:hover {
        opacity: 1;
    }

    .toggle-icon {
        width: 1.25rem;
        height: 1.25rem;
        filter: invert(1);
    }

    .form-checkbox {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
    }

    .form-checkbox input {
        width: 1rem;
        height: 1rem;
        cursor: pointer;
        accent-color: var(--primary-color, #8b5cf6);
    }

    .form-checkbox-label {
        font-size: 0.875rem;
        color: var(--slate-400);
        cursor: pointer;
        user-select: none;
    }

    .auth-divider {
        text-align: center;
        margin: 2rem 0;
        color: var(--slate-500);
        font-size: 0.875rem;
    }

    :global(.btn-primary),
    :global(.btn-secondary) {
        font-weight: 500;
        padding: 0.75rem 1.5rem;
    }
</style>
