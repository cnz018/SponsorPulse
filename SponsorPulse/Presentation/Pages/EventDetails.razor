@page "/event/{Slug}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SponsorPulse.Application.Common.Interfaces
@using SponsorPulse.Domain.Entities
@using SponsorPulse.Infrastructure.Persistence
@using SponsorPulse.Presentation.Components.Twitch
@using SponsorPulse.Presentation.Components.Twitter
@using SponsorPulse.Presentation.Components.Media
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SponsorPulseDbContext> DbFactory
@inject IMediaStorageService MediaStorageService
@inject NavigationManager Navigation

<PageTitle>@(_event?.Name ?? "Détails") - SponsorPulse</PageTitle>

<div class="modal-page-backdrop">
    <div class="modal-page-content glass-panel fade-in-up">
        <div class="header">
            <button class="back-btn" @onclick="GoBack">
                ← Retour
            </button>
            <div class="actions">
                <!-- Actions placeholder (Edit, Delete) -->
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="p-8 text-center text-gray-400">Chargement de l'événement...</div>
        }
        else if (_event == null)
        {
            <div class="p-8 text-center">
                <h2 class="text-xl text-white mb-2">Événement introuvable</h2>
                <p class="text-gray-400">L'événement demandé n'existe pas ou a été supprimé.</p>
                <button class="btn-primary mt-4" @onclick="GoBack">Retourner au tableau de bord</button>
            </div>
        }
        else
        {
            <div class="event-details">
                <h1 class="text-3xl font-bold text-white mb-2">@_event.Name</h1>
                <div class="meta-row mb-8 flex items-center">
                    <span class="badge">@_event.StreamPlatform</span>
                    <span class="date">@_event.Date.ToLongDateString()</span>
                    <span class="slug-tag ml-4 text-xs text-gray-500">#@_event.Slug</span>
                </div>

                <div class="section mb-6">
                    <h3 class="section-title">Description</h3>
                    <p class="text-gray-300 leading-relaxed">@(_event.Description ?? "Aucune description fournie.")</p>
                </div>

                @if (_event.StreamPlatform == "Twitch")
                {
                    <div class="section mb-6">
                        <h3 class="section-title">Données Stream</h3>
                        <TwitchFetcher EventToUpdate="@_event" OnDataUpdated="HandleDataUpdated" />
                    </div>
                }

                @if (!string.IsNullOrEmpty(_event.TwitterHashtags))
                {
                    <div class="section mb-6">
                        <h3 class="section-title">Données Twitter</h3>
                        <TwitterFetcher EventToUpdate="@_event" OnDataUpdated="HandleDataUpdated" />
                    </div>
                }

                @* <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="section">
                        <h3 class="section-title">ID de la Chaîne</h3>
                        <div class="code-block">
                            <code>@_event.ChannelId</code>
                        </div>
                    </div>
                </div> *@

                <div class="section mb-6 mt-8" id="media-section">
                    <h3 class="section-title">Médias Événement (Photos)</h3>
                    <div class="media-container mb-4">
                        @if (_event.Media.Any())
                        {
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                                @foreach (var media in _event.Media)
                                {
                                    <div class="media-card group relative">
                                        <img src="@media.Url" alt="@media.OriginalFileName" 
                                             class="w-full h-32 object-cover rounded-lg border border-white/10" 
                                             @onclick="() => OpenLightbox(media.Url)" />
                                        
                                        <button class="btn-delete-media absolute top-2 right-2 bg-red-500/80 hover:bg-red-600 text-white p-1 rounded-full opacity-0 group-hover:opacity-100 transition-opacity"
                                                @onclick="() => DeleteMedia(media)" @onclick:stopPropagation>
                                            <span class="icon-small">🗑️</span>
                                        </button>
                                        <span class="text-xs text-gray-400 mt-1 block truncate">@media.OriginalFileName</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    
                    @if (_event.Media.Count < 5)
                    {
                        <MediaUploader EventSlug="@_event.Slug" OnUploadCompleted="HandleMediaUploaded" />
                    }
                    else
                    {
                        <p class="text-yellow-500 text-sm">Limite de 5 photos atteinte.</p>
                    }
                </div>

                <div class="section mt-8 pt-6 border-t border-gray-800">
                    <button class="btn-action">Générer Rapport</button>
                </div>
            </div>
        }
    </div>
</div>

@if (_lightboxUrl != null)
{
    <div class="fixed inset-0 z-[2000] bg-black/90 flex items-center justify-center p-4 backdrop-blur-sm" @onclick="CloseLightbox">
        <div class="relative max-w-7xl max-h-screen">
            <button class="absolute -top-12 right-0 text-white hover:text-gray-300 text-3xl" @onclick="CloseLightbox">✕</button>
            <img src="@_lightboxUrl" class="max-h-[85vh] max-w-full rounded-lg shadow-2xl" @onclick:stopPropagation />
        </div>
    </div>
}

<style>
    .modal-page-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(5, 10, 20, 0.85);
        /* Dark overlay */
        backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 1rem;
    }

    .modal-page-content {
        width: 100%;
        max-width: 800px;
        max-height: 90vh;
        overflow-y: auto;
        padding: 2.5rem;
        border-radius: 24px;
        background: linear-gradient(145deg, rgba(30, 41, 59, 0.9), rgba(15, 23, 42, 0.95));
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 2rem;
    }

    .back-btn {
        background: transparent;
        border: none;
        color: var(--lavender);
        cursor: pointer;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0;
        font-size: 1rem;
        opacity: 0.8;
        transition: opacity 0.2s;
    }

    .back-btn:hover {
        opacity: 1;
    }

    .section-title {
        color: var(--grey-text);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 0.75rem;
        margin-bottom: 0.75rem;
        font-weight: 700;
    }

    .badge {
        background: rgba(59, 130, 246, 0.2);
        color: #60A5FA;
        border: 1px solid rgba(59, 130, 246, 0.4);
        padding: 0.25rem 0.75rem;
        border-radius: 99px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .date {
        color: var(--grey-text);
        margin-left: 1rem;
    }

    .text-gray-300 {
        color: #cbd5e1;
    }

    .text-gray-400 {
        color: #94a3b8;
    }

    .text-gray-500 {
        color: #64748b;
    }

    .leading-relaxed {
        line-height: 1.625;
    }

    .border-t {
        border-top-width: 1px;
    }

    .border-gray-800 {
        border-color: rgba(255, 255, 255, 0.1);
    }

    .pt-6 {
        padding-top: 1.5rem;
    }

    .ml-4 {
        margin-left: 1rem;
    }

    .code-block {
        background: rgba(0, 0, 0, 0.3);
        padding: 0.75rem 1rem;
        border-radius: 8px;
        font-family: monospace;
        color: var(--lavender);
        border: 1px solid rgba(255, 255, 255, 0.05);
        display: inline-block;
    }

    .btn-action {
        background: linear-gradient(135deg, var(--accent-blue) 0%, #2563EB 100%);
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-action:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3);
    }
    
    /* Media Grid Styles */
    .media-card {
        transition: transform 0.2s;
    }
    
    .media-card:hover {
        transform: scale(1.02);
    }
    
    .icon-small {
        font-size: 0.8rem;
    }

    .fade-in-up {
        animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
</style>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    private Event? _event;
    private bool _isLoading = true;
    private string? _lightboxUrl;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            _event = await context.Events
                .Include(e => e.Media)
                .FirstOrDefaultAsync(e => e.Slug == Slug);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    private async Task HandleDataUpdated(Event updatedEvent)
    {
        _event = updatedEvent;
        // Save to DB
        using var context = await DbFactory.CreateDbContextAsync();
        context.Events.Update(_event);
        await context.SaveChangesAsync();
        StateHasChanged();
    }

    private async Task HandleMediaUploaded(List<UploadedMediaResult> results)
    {
        if (_event == null) return;

        using var context = await DbFactory.CreateDbContextAsync();
        var eventEntity = await context.Events.Include(e => e.Media).FirstAsync(e => e.Id == _event.Id);
        
        foreach (var result in results)
        {
            if (eventEntity.Media.Count >= 5) break;

            var media = EventMedia.Create(
                result.OriginalFileName,
                result.StorageFileName,
                result.Url,
                result.Size,
                result.ContentType
            );
            eventEntity.Media.Add(media);
        }
        
        await context.SaveChangesAsync();
        // Reload to ensure we have the latest state (IDs etc)
        _event = eventEntity;
        StateHasChanged();
    }
    
    private async Task DeleteMedia(EventMedia media)
    {
        if (_event == null) return;
        
        // Optimistic UI update
        _event.Media.Remove(media);
        StateHasChanged();
        
        try 
        {
            await MediaStorageService.DeleteMediaAsync(media.StorageFileName);
            
            using var context = await DbFactory.CreateDbContextAsync();
            var eventEntity = await context.Events.Include(e => e.Media).FirstAsync(e => e.Id == _event.Id);
            
            // Find and remove by ID
            var mediaToDelete = eventEntity.Media.FirstOrDefault(m => m.Id == media.Id);
            if (mediaToDelete != null)
            {
                eventEntity.Media.Remove(mediaToDelete);
                await context.SaveChangesAsync();
            }
        }
        catch(Exception)
        {
            // Revert on error
            _event.Media.Add(media);
            StateHasChanged();
        }
    }
    
    private void OpenLightbox(string url) => _lightboxUrl = url;
    private void CloseLightbox() => _lightboxUrl = null;
}