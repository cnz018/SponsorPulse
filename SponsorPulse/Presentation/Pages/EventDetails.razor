@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnOpenPdfCustomize { get; set; }
    private Event? _event;
    private bool _isLoading = true;
    private string? _lightboxUrl;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (DemoDataService.IsInDemoMode)
            {
                Console.WriteLine(Slug);

                // Mode démo: charger depuis StaticDemoRepository
                _event = await DemoDataService.GetDemoEventBySlugAsync(Slug);

                if (_event is null)
                {
                    return;
                }
                
                // Si l'événement n'a pas de TwitterAnalytics, utiliser StaticReportRepository
                if (string.IsNullOrEmpty(_event.TwitterHashtags))
                {
                    // Assigner un hashtag par défaut pour afficher les données Twitter
                    _event.TwitterHashtags = "#" + _event.Name.Replace(" ", "");
                    
                    // Charger les données Twitter depuis StaticReportRepository
                    var reports = StaticReportRepository.GetAllReports();
                    if (reports.ContainsKey(_event.Slug))
                    {
                        _event.TwitterAnalytics = reports[_event.Slug];
                    }
                    else
                    {
                        // Utiliser un rapport générique basé sur le nom
                        _event.TwitterAnalytics = StaticReportRepository.GetCustomEventReport(
                            _event.Name.Replace(" ", ""),
                            "@TopInfluencer"
                        );
                    }
                }
            }
            else
            {
                // Mode normal: charger depuis la base de données
                using var context = await DbFactory.CreateDbContextAsync();
                _event = await context.Events
                    .Include(e => e.Media)
                    .FirstOrDefaultAsync(e => e.Slug == Slug);
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoBack()
    {
        if (OnClose.HasDelegate)
        {
            OnClose.InvokeAsync();
        }
        else
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task HandleDataUpdated(Event updatedEvent)
    {
        _event = updatedEvent;
        // Save to DB
        using var context = await DbFactory.CreateDbContextAsync();
        context.Events.Update(_event);
        await context.SaveChangesAsync();
        StateHasChanged();
    }

    private async Task HandleMediaUploaded(List<UploadedMediaResult> results)
    {
        if (_event == null) return;

        using var context = await DbFactory.CreateDbContextAsync();
        var eventEntity = await context.Events.Include(e => e.Media).FirstAsync(e => e.Id == _event.Id);

        foreach (var result in results)
        {
            if (eventEntity.Media.Count >= 5) break;

            var media = EventMedia.Create(
                result.OriginalFileName,
                result.StorageFileName,
                result.Url,
                result.Size,
                result.ContentType
            );
            eventEntity.Media.Add(media);
        }

        await context.SaveChangesAsync();
        // Reload to ensure we have the latest state (IDs etc)
        _event = eventEntity;
        StateHasChanged();
    }

    private async Task DeleteMedia(EventMedia media)
    {
        if (_event == null) return;

        // Optimistic UI update
        _event.Media.Remove(media);
        StateHasChanged();

        try
        {
            await MediaStorageService.DeleteMediaAsync(media.StorageFileName);

            using var context = await DbFactory.CreateDbContextAsync();
            var eventEntity = await context.Events.Include(e => e.Media).FirstAsync(e => e.Id == _event.Id);

            // Find and remove by ID
            var mediaToDelete = eventEntity.Media.FirstOrDefault(m => m.Id == media.Id);
            if (mediaToDelete != null)
            {
                eventEntity.Media.Remove(mediaToDelete);
                await context.SaveChangesAsync();
            }
        }
        catch(Exception)
        {
            // Revert on error
            _event.Media.Add(media);
            StateHasChanged();
        }
    }

    private void OpenLightbox(string url) => _lightboxUrl = url;
    private void CloseLightbox() => _lightboxUrl = null;
    
    private void OpenPdfCustomize()
    {
        OnOpenPdfCustomize.InvokeAsync(Slug);
    }
}
