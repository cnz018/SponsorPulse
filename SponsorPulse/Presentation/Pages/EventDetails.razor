@page "/event/{Slug}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SponsorPulse.Application.Common.Interfaces
@using SponsorPulse.Domain.Entities
@using SponsorPulse.Infrastructure.Persistence
@using SponsorPulse.Infrastructure.Repositories
@using SponsorPulse.Application.Services
@using SponsorPulse.Presentation.Components.Twitch
@using SponsorPulse.Presentation.Components.Twitter
@using SponsorPulse.Presentation.Components.Media
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SponsorPulseDbContext> DbFactory
@inject IMediaStorageService MediaStorageService
@inject NavigationManager Navigation
@inject IDemoDataService DemoDataService

<PageTitle>@(_event?.Name ?? "Détails") - SponsorPulse</PageTitle>

<div class="modal-page-backdrop">
    <div class="modal-page-content glass-panel fade-in-up">
        <div class="header">
            <button class="back-btn" @onclick="GoBack">
                ← Retour
            </button>
            <div class="actions">
                <!-- Actions placeholder (Edit, Delete) -->
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="p-8 text-center text-gray-400">Chargement de l'événement...</div>
        }
        else if (_event == null)
        {
            <div class="p-8 text-center">
                <h2 class="text-xl text-white mb-2">Événement introuvable</h2>
                <p class="text-gray-400">L'événement demandé n'existe pas ou a été supprimé.</p>
                <button class="btn-primary mt-4" @onclick="GoBack">Retourner au tableau de bord</button>
            </div>
        }
        else
        {
            <div class="event-details">
                <h1 class="event-title mb-2">@_event.Name</h1>
                <div class="meta-row mb-8">
                    <span class="badge badge-@(_event.StreamPlatform?.ToLower() ?? "default")">
                        <img src="https://api.iconify.design/@(GetPlatformIcon(_event.StreamPlatform)).svg"
                             class="badge-platform-icon" alt="" />
                        @_event.StreamPlatform
                    </span>
                    <span class="meta-date">
                        <img src="https://api.iconify.design/ic:outline-calendar-today.svg" class="meta-icon" alt="" />
                        @_event.Date.ToLongDateString()
                    </span>
                    <span class="meta-slug">#@_event.Slug</span>
                </div>

                <div class="section mb-6">
                    <h3 class="section-title">Description</h3>
                    <p class="text-gray-300 leading-relaxed">@(_event.Description ?? "Aucune description fournie.")</p>
                </div>

                @if (_event.StreamPlatform == "Twitch")
                {
                    <div class="section mb-6">
                        <h3 class="section-title">Données Stream</h3>
                        @if (DemoDataService.IsInDemoMode)
                        {
                            <div class="demo-twitch-metrics">
                                <div class="detail-stats-row">
                                    <div class="detail-stat-card">
                                        <div class="dsc-header">
                                            <img src="https://api.iconify.design/ic:outline-remove-red-eye.svg" class="dsc-icon" alt="" />
                                            <span class="dsc-label">Viewers Actuels</span>
                                        </div>
                                        <span class="dsc-value">@_event.ViewerCount?.ToString("N0")</span>
                                    </div>
                                    <div class="detail-stat-card">
                                        <div class="dsc-header">
                                            <img src="https://api.iconify.design/ic:outline-trending-up.svg" class="dsc-icon" alt="" />
                                            <span class="dsc-label">Pic de Viewers</span>
                                        </div>
                                        <span class="dsc-value">@_event.PeakViewers?.ToString("N0")</span>
                                    </div>
                                    <div class="detail-stat-card">
                                        <div class="dsc-header">
                                            <img src="https://api.iconify.design/ic:outline-timer.svg" class="dsc-icon" alt="" />
                                            <span class="dsc-label">Durée</span>
                                        </div>
                                        <span class="dsc-value">@(_event.StreamDuration?.Hours)h @(_event.StreamDuration?.Minutes)m</span>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(_event.GameName))
                                {
                                    <div class="info-field">
                                        <span class="info-field-label">Jeu</span>
                                        <span class="info-field-value">@_event.GameName</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <TwitchFetcher EventToUpdate="@_event" OnDataUpdated="HandleDataUpdated" />
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(_event.TwitterHashtags))
                {
                    <div class="section mb-6">
                        <h3 class="section-title">Données Twitter</h3>
                        @if (DemoDataService.IsInDemoMode && _event.TwitterAnalytics != null)
                        {
                            <div class="demo-twitter-metrics">
                                <div class="hero-metric">
                                    <div class="hero-metric-label">
                                        <img src="https://api.iconify.design/ic:outline-monetization-on.svg" class="hero-icon" alt="" />
                                        <span>Valeur Publicitaire</span>
                                    </div>
                                    <span class="hero-metric-value">@_event.TwitterAnalytics.AdValueEquivalent.ToString("C0")</span>
                                </div>
                                <div class="detail-stats-row">
                                    <div class="detail-stat-card">
                                        <div class="dsc-header">
                                            <img src="https://api.iconify.design/ic:outline-tag.svg" class="dsc-icon" alt="" />
                                            <span class="dsc-label">Total Tweets</span>
                                        </div>
                                        <span class="dsc-value">@_event.TwitterAnalytics.TotalTweets.ToString("N0")</span>
                                    </div>
                                    <div class="detail-stat-card">
                                        <div class="dsc-header">
                                            <img src="https://api.iconify.design/ic:outline-message.svg" class="dsc-icon" alt="" />
                                            <span class="dsc-label">Engagement Total</span>
                                        </div>
                                        <span class="dsc-value">@_event.TwitterAnalytics.TotalEngagement.ToString("N0")</span>
                                    </div>
                                    <div class="detail-stat-card">
                                        <div class="dsc-header">
                                            <img src="https://api.iconify.design/ic:outline-monitor.svg" class="dsc-icon" alt="" />
                                            <span class="dsc-label">Impressions</span>
                                        </div>
                                        <span class="dsc-value">@_event.TwitterAnalytics.EstimatedImpressions.ToString("N0")</span>
                                    </div>
                                </div>

                                @if (_event.TwitterAnalytics.TopTweets?.Any() == true)
                                {
                                    <div class="top-tweets-section mt-6">
                                        <h4 class="tweets-title">Top Tweets</h4>
                                        <div class="tweets-list">
                                            @foreach (var tweet in _event.TwitterAnalytics.TopTweets.Take(3))
                                            {
                                                <div class="tweet-card">
                                                    <div class="tweet-header">
                                                        <span class="tweet-author">@tweet.AuthorName</span>
                                                        <span class="tweet-handle">@tweet.AuthorHandle</span>
                                                        <span class="tweet-followers">(@tweet.AuthorFollowersCount.ToString("N0") followers)</span>
                                                    </div>
                                                    <p class="tweet-text">@tweet.Text</p>
                                                    <div class="tweet-metrics">
                                                        <span>❤️ @tweet.Likes.ToString("N0")</span>
                                                        <span>🔁 @tweet.Retweets.ToString("N0")</span>
                                                        <span>💬 @tweet.Replies.ToString("N0")</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (_event.TwitterAnalytics.SentimentRatio?.Any() == true)
                                {
                                    <div class="sentiment-section mt-6">
                                        <h4 class="tweets-title">Sentiment</h4>
                                        <div class="sentiment-stacked-bar">
                                            @foreach (var sentiment in _event.TwitterAnalytics.SentimentRatio)
                                            {
                                                <div class="sentiment-segment @GetSentimentSegmentClass(sentiment.Key)"
                                                     style="width: @sentiment.Value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"
                                                     title="@sentiment.Key : @sentiment.Value.ToString("F1")%"></div>
                                            }
                                        </div>
                                        <div class="sentiment-cards">
                                            @foreach (var sentiment in _event.TwitterAnalytics.SentimentRatio)
                                            {
                                                <div class="sentiment-card @GetSentimentCardClass(sentiment.Key)">
                                                    <span class="sentiment-emoji">@GetSentimentEmoji(sentiment.Key)</span>
                                                    <span class="sentiment-pct @GetSentimentValueClass(sentiment.Key)">@sentiment.Value.ToString("F1")%</span>
                                                    <span class="sentiment-card-label">@sentiment.Key</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <TwitterFetcher EventToUpdate="@_event" OnDataUpdated="HandleDataUpdated" />
                        }
                    </div>
                }

                <div class="section mb-6 mt-8" id="media-section">
                    <h3 class="section-title">Médias Événement (Photos)</h3>
                    <div class="media-container mb-4">
                        @if (_event.Media.Any())
                        {
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                                @foreach (var media in _event.Media)
                                {
                                    <div class="media-card group relative">
                                        <img src="@media.Url" alt="@media.OriginalFileName"
                                             class="w-full h-32 object-cover rounded-lg border border-white/10"
                                             @onclick="() => OpenLightbox(media.Url)" />

                                        <button class="btn-delete-media absolute top-2 right-2 bg-red-500/80 hover:bg-red-600 text-white p-1 rounded-full opacity-0 group-hover:opacity-100 transition-opacity"
                                                @onclick="() => DeleteMedia(media)" @onclick:stopPropagation>
                                            <span class="icon-small">🗑️</span>
                                        </button>
                                        <span class="text-xs text-gray-400 mt-1 block truncate">@media.OriginalFileName</span>
                                    </div>
                                }
                            </div>
                        }
                        else if (DemoDataService.IsInDemoMode)
                        {
                            <p class="text-gray-400 text-sm">Aucun média en mode démo.</p>
                        }
                    </div>

                    @if (!DemoDataService.IsInDemoMode && _event.Media.Count < 5)
                    {
                        <MediaUploader EventSlug="@_event.Slug" OnUploadCompleted="HandleMediaUploaded" />
                    }
                    else if (_event.Media.Count >= 5)
                    {
                        <p class="text-yellow-500 text-sm">Limite de 5 photos atteinte.</p>
                    }
                </div>

                <div class="section mt-8 pt-6 border-t border-gray-800">
                    <button class="btn-generate" @onclick="OpenPdfCustomize">
                        <img src="https://api.iconify.design/ic:outline-picture-as-pdf.svg"
                             class="btn-generate-icon" alt="" />
                        Générer Rapport
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@if (_lightboxUrl != null)
{
    <div class="fixed inset-0 z-[2000] bg-black/90 flex items-center justify-center p-4 backdrop-blur-sm" @onclick="CloseLightbox">
        <div class="relative max-w-7xl max-h-screen">
            <button class="absolute -top-12 right-0 text-white hover:text-gray-300 text-3xl" @onclick="CloseLightbox">✕</button>
            <img src="@_lightboxUrl" class="max-h-[85vh] max-w-full rounded-lg shadow-2xl" @onclick:stopPropagation />
        </div>
    </div>
}

<style>
    .modal-page-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(5, 10, 20, 0.85);
        /* Dark overlay */
        backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 1rem;
    }

    .modal-page-content {
        width: 100%;
        max-width: 800px;
        max-height: 90vh;
        overflow-y: auto;
        padding: 2.5rem;
        border-radius: 24px;
        background: linear-gradient(145deg, rgba(30, 41, 59, 0.9), rgba(15, 23, 42, 0.95));
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 2rem;
    }

    .back-btn {
        background: transparent;
        border: none;
        color: var(--lavender);
        cursor: pointer;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.75rem;
        font-size: 0.9rem;
        opacity: 0.8;
        transition: opacity 0.2s, transform 0.2s, background 0.2s;
        border-radius: var(--radius-btn);
    }

    .back-btn:hover {
        opacity: 1;
        transform: translateX(-3px);
        background: rgba(204, 201, 220, 0.08);
    }

    .section-title {
        color: var(--grey-text);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.7rem;
        margin-bottom: 1rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .section-title::before {
        content: '';
        display: inline-block;
        width: 3px;
        height: 13px;
        background: var(--lavender);
        border-radius: 2px;
        opacity: 0.45;
        flex-shrink: 0;
    }

    .badge {
        background: rgba(59, 130, 246, 0.2);
        color: #60A5FA;
        border: 1px solid rgba(59, 130, 246, 0.4);
        padding: 0.25rem 0.75rem;
        border-radius: 99px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .date {
        color: var(--grey-text);
        margin-left: 1rem;
    }

    .code-block {
        background: rgba(0, 0, 0, 0.3);
        padding: 0.75rem 1rem;
        border-radius: 8px;
        font-family: monospace;
        color: var(--lavender);
        border: 1px solid rgba(255, 255, 255, 0.05);
        display: inline-block;
    }

    .btn-action {
        background: linear-gradient(135deg, var(--accent-blue) 0%, #2563EB 100%);
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-action:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3);
    }

    /* Media Grid Styles */
    .media-card {
        transition: transform 0.2s;
    }

    .media-card:hover {
        transform: scale(1.02);
    }

    .icon-small {
        font-size: 0.8rem;
    }

    .fade-in-up {
        animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* Detail Stat Cards */
    .detail-stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.875rem;
    }

    .detail-stat-card {
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.015) 100%);
        border: 1px solid rgba(148, 163, 184, 0.12);
        border-radius: 12px;
        padding: 1rem 1.125rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        transition: border-color 0.2s, transform 0.2s;
    }

    .detail-stat-card:hover {
        border-color: rgba(204, 201, 220, 0.22);
        transform: translateY(-2px);
    }

    .dsc-header {
        display: flex;
        align-items: center;
        gap: 0.45rem;
    }

    .dsc-icon {
        width: 14px;
        height: 14px;
        filter: brightness(0) saturate(100%) invert(65%) sepia(10%) saturate(200%) hue-rotate(194deg) brightness(90%) contrast(90%);
        flex-shrink: 0;
    }

    .dsc-label {
        font-size: 0.67rem;
        color: var(--grey-text);
        text-transform: uppercase;
        letter-spacing: 0.07em;
        font-weight: 600;
    }

    .dsc-value {
        font-size: 1.6rem;
        font-weight: 700;
        background: linear-gradient(135deg, var(--white) 0%, var(--lavender) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.2;
        padding: 0.1rem 0;
    }

    /* Inline labeled field (non-numeric values like Jeu) */
    .info-field {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 0.75rem;
        padding: 0.6rem 0.875rem;
        background: rgba(255, 255, 255, 0.02);
        border-radius: 8px;
        border: 1px solid rgba(148, 163, 184, 0.07);
    }

    .info-field-label {
        font-size: 0.67rem;
        color: var(--grey-text);
        text-transform: uppercase;
        letter-spacing: 0.07em;
        font-weight: 600;
        white-space: nowrap;
        min-width: 2rem;
    }

    .info-field-value {
        font-size: 1rem;
        font-weight: 600;
        color: var(--white);
    }

    /* Hero metric banner (most commercially important stat) */
    .hero-metric {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.125rem 1.375rem;
        margin-bottom: 0.875rem;
        background: linear-gradient(135deg, rgba(204, 201, 220, 0.07) 0%, rgba(204, 201, 220, 0.02) 100%);
        border: 1px solid rgba(204, 201, 220, 0.18);
        border-radius: 12px;
    }

    .hero-metric-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.7rem;
        color: var(--grey-text);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 700;
    }

    .hero-icon {
        width: 16px;
        height: 16px;
        filter: brightness(0) saturate(100%) invert(85%) sepia(6%) saturate(19%) hue-rotate(194deg) brightness(94%) contrast(93%);
    }

    .hero-metric-value {
        font-size: 2rem;
        font-weight: 700;
        background: linear-gradient(135deg, var(--white) 0%, var(--lavender) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1;
    }

    .top-tweets-section,
    .sentiment-section {
        border-top: 1px solid rgba(148, 163, 184, 0.2);
        padding-top: 1.5rem;
    }

    .tweets-title {
        font-size: 0.9rem;
        color: var(--grey-text);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 1rem;
    }

    .tweets-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .tweet-card {
        background: rgba(255, 255, 255, 0.02);
        padding: 1rem 1.25rem;
        border-radius: 12px;
        border: 1px solid rgba(148, 163, 184, 0.08);
        transition: background 0.2s, border-color 0.2s;
    }

    .tweet-card:hover {
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(148, 163, 184, 0.15);
    }

    .tweet-header {
        display: flex;
        gap: 0.5rem;
        align-items: baseline;
        margin-bottom: 0.75rem;
    }

    .tweet-author {
        font-weight: 600;
        color: var(--white);
    }

    .tweet-handle {
        color: var(--grey-text);
        font-size: 0.9rem;
    }

    .tweet-followers {
        color: var(--grey-text);
        font-size: 0.85rem;
        opacity: 0.7;
    }

    .tweet-text {
        color: var(--white);
        margin-bottom: 0.75rem;
        line-height: 1.5;
    }

    .tweet-metrics {
        display: flex;
        gap: 1rem;
        font-size: 0.85rem;
        color: var(--grey-text);
    }

    /* Creative Sentiment Layout */
    .sentiment-stacked-bar {
        display: flex;
        height: 10px;
        border-radius: 99px;
        overflow: hidden;
        margin-bottom: 1rem;
        gap: 2px;
    }

    .sentiment-segment {
        height: 100%;
        border-radius: 99px;
        transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .segment-positive { background: linear-gradient(90deg, #16A34A, #4ADE80); }
    .segment-neutral  { background: linear-gradient(90deg, #475569, #94A3B8); }
    .segment-negative { background: linear-gradient(90deg, #DC2626, #F87171); }

    .sentiment-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
    }

    .sentiment-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.3rem;
        padding: 1rem 0.75rem;
        border-radius: 12px;
        border: 1px solid;
        text-align: center;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .sentiment-card:hover { transform: translateY(-3px); }

    .card-positive {
        background: rgba(34, 197, 94, 0.06);
        border-color: rgba(34, 197, 94, 0.2);
        box-shadow: 0 4px 12px rgba(34, 197, 94, 0.06);
    }

    .card-positive:hover { box-shadow: 0 8px 20px rgba(34, 197, 94, 0.12); }

    .card-neutral {
        background: rgba(148, 163, 184, 0.06);
        border-color: rgba(148, 163, 184, 0.15);
    }

    .card-negative {
        background: rgba(239, 68, 68, 0.06);
        border-color: rgba(239, 68, 68, 0.2);
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.04);
    }

    .card-negative:hover { box-shadow: 0 8px 20px rgba(239, 68, 68, 0.1); }

    .sentiment-emoji {
        font-size: 1.6rem;
        line-height: 1;
        margin-bottom: 0.1rem;
    }

    .sentiment-pct {
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1.1;
    }

    .value-positive { color: #4ADE80; }
    .value-neutral   { color: var(--grey-text); }
    .value-negative  { color: #F87171; }

    .sentiment-card-label {
        font-size: 0.65rem;
        color: var(--grey-text);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 600;
    }

    /* ── Event Title ── */
    .event-title {
        font-size: 1.875rem;
        font-weight: 700;
        background: linear-gradient(135deg, var(--white) 0%, var(--lavender) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.2;
    }

    /* ── Meta Row ── */
    .meta-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.3rem 0.75rem;
        border-radius: 99px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .badge-twitch {
        background: rgba(145, 70, 255, 0.15);
        color: #A970FF;
        border: 1px solid rgba(145, 70, 255, 0.3);
    }

    .badge-twitter, .badge-x {
        background: rgba(29, 155, 240, 0.15);
        color: #1D9BF0;
        border: 1px solid rgba(29, 155, 240, 0.3);
    }

    .badge-default {
