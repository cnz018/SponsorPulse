                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                                    </svg>
                                </summary>
                                <div class="px-6 pt-2 pb-6 text-[#94A3B8]">
                                    <p class="mb-3">Nous sommes actuellement en <strong class="text-white">beta fermée</strong>.
                                    </p>
                                    <p>Les premiers utilisateurs auront :</p>
