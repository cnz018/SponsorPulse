                                        <li>Twitch + Twitter (30j) : 5-7 minutes</li>
                                        <li>Twitch + Twitter (90j) : 8-10 minutes</li> 
                                    </ul>*@
                                </div>
                            </details>

                            <!-- FAQ Item 4 -->
                            <details class="faq-item group cursor-pointer">
                                <summary
                                    class="flex items-center justify-between p-6 bg-white/5 hover:bg-white/10 rounded-xl border border-white/10 group-open:border-[#CCC9DC]/50 transition-all">
