@page "/password-recovery"
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations
@inject UserManager<SponsorPulse.Domain.Entities.ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>Récupération mot de passe</PageTitle>

<div class="auth-wrapper">
    <h2>Récupération du mot de passe</h2>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="auth-info">@message</div>
    }

    <EditForm Model="model" OnValidSubmit="HandleRequest">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-row">
            <label>Email</label>
            <InputText @bind-Value="model.Email" />
        </div>

        <button class="btn-primary" type="submit">Demander la réinitialisation</button>
    </EditForm>

    <p class="mt-4">Vous recevrez un lien de réinitialisation par email si l'adresse existe dans notre système.</p>
</div>

@code {
    private RequestModel model = new();
    private string? message;

    private class RequestModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;
    }

    private async Task HandleRequest()
    {
        var user = await UserManager.FindByEmailAsync(model.Email);
        if (user == null)
        {
            // Ne pas révéler l'existence d'un compte
            message = "Si un compte existe pour cette adresse, vous recevrez un email sous peu.";
            return;
        }

        var token = await UserManager.GeneratePasswordResetTokenAsync(user);

        // TODO: Envoyer le token par email. En mode démo on affiche un message générique.
        message = "Un e-mail de réinitialisation a été demandé. (Dans un environnement réel, un email serait envoyé.)";
    }
}
