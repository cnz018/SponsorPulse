@page "/"
@using SponsorPulse.Domain.Entities
@inject NavigationManager Navigation

<PageTitle>Dashboard - SponsorPulse</PageTitle>

<div class="dashboard-content fade-in">
    <div class="glass-panel header-panel mb-8">
        <h1 class="text-3xl font-bold mb-2">Bienvenue sur SponsorPulse</h1>
        <p class="text-gray-400">Générez vos rapports sponsors professionnels en quelques clics.</p>
    </div>

    <div class="stats-grid">
        <div class="glass-card">
            <h3>Événements</h3>
            <div class="value">0</div>
        </div>
        <div class="glass-card">
            <h3>Rapports</h3>
            <div class="value">0</div>
        </div>
        <div class="glass-card action-card" @onclick="GoToCreate">
            <button class="btn-create">+ Créer un événement</button>
        </div>
    </div>
</div>

<style>
    .dashboard-content {
        animation: fadeIn 0.5s ease-out;
    }

    .header-panel {
        padding: 2rem;
        background: linear-gradient(135deg, rgba(50, 74, 95, 0.4) 0%, rgba(12, 24, 33, 0.4) 100%);
    }

    .mb-8 { margin-bottom: 2rem; }
    .mb-2 { margin-bottom: 0.5rem; }
    .text-3xl { font-size: 1.875rem; }
    .font-bold { font-weight: 700; }
    .text-gray-400 { color: var(--grey-text); }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
    }

    .glass-card {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s, background 0.2s;
        cursor: default;
        min-height: 160px;
    }

    .glass-card:hover {
        background: rgba(255, 255, 255, 0.08);
    }

    .glass-card.action-card {
        cursor: pointer;
        border: 1px dashed var(--charcoal-blue);
    }

    .glass-card.action-card:hover {
        border-color: var(--lavender);
        transform: translateY(-4px);
    }

    .glass-card h3 {
        margin: 0 0 0.5rem 0;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--grey-text);
    }

    .glass-card .value {
        font-size: 3rem;
        font-weight: 700;
        background: linear-gradient(135deg, var(--white) 0%, var(--lavender) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .btn-create {
        background: transparent;
        border: none;
        color: var(--lavender);
        font-weight: 600;
        font-size: 1.1rem;
        cursor: pointer;
        pointer-events: none; /* Let the card handle click */
    }
</style>

@code {
    private void GoToCreate()
    {
        Navigation.NavigateTo("create-event");
    }
}
