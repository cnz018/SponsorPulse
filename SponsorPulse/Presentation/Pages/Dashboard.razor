@page "/dashboard"
@rendermode RenderMode.InteractiveServer
@using SponsorPulse.Domain.Entities
@using SponsorPulse.Infrastructure.Persistence
@using SponsorPulse.Presentation.Components
@using SponsorPulse.Infrastructure.Repositories
@using SponsorPulse.Application.Services
@using Microsoft.EntityFrameworkCore
@inject NavigationManager Navigation
@inject IDbContextFactory<SponsorPulseDbContext> DbFactory
@inject IDemoDataService DemoDataService

<PageTitle>Dashboard - SponsorPulse</PageTitle>

<div class="dashboard-content fade-in">
    <div class="glass-panel header-panel mb-8">
        <h1 class="text-3xl font-bold mb-2">Bienvenue sur SponsorPulse</h1>
        <p class="text-gray-400">Générez vos rapports sponsors professionnels en quelques clics.</p>
    </div>

    <div class="stats-grid mb-8">
        <div class="glass-card">
            <h3>Événements</h3>
            <div class="value">@(events?.Count ?? 0)</div>
        </div>
        <div class="glass-card">
            <h3>Rapports</h3>
            <div class="value">0</div>
        </div>
        <div class="glass-card action-card" @onclick="GoToCreate">
            <button class="btn-create">+ Créer un événement</button>
        </div>
    </div>

    <h2 class="text-xl font-bold text-white mb-6">Vos Événements</h2>

    <EventSelector Events="events" OnEdit="HandleEditEvent"        OnDelete="HandleDeleteEvent"        OnAnalyze="HandleAnalyzeEvent"
                   OnGenerate="HandleGenerateEvent"        OnBulkAnalyze="HandleBulkAnalyze"        OnBulkDelete="HandleBulkDelete" />

    @if (showCreateModal)
    {
        <CreateEvent OnClose="@(() => showCreateModal = false)" OnCreated="HandleEventCreated" />
    }

    @if (eventToDelete != null)
    {
        <div class="modal-backdrop" @onclick="CancelDelete">
            <div class="modal-content glass-panel" @onclick:stopPropagation>
                <div class="mb-4">
                    <h2 class="text-xl font-bold text-white">Supprimer définitivement</h2>
                </div>

                <p class="text-gray-300 mb-6">
                    Etes vous sur de vouloir supprimer cet event <strong>@eventToDelete.Name</strong> ?
                </p>

                <div class="flex justify-end gap-4">
                    <button class="btn-cancel" @onclick="CancelDelete">Annuler</button>
                    <button class="btn-delete-confirm" @onclick="ConfirmDelete">Oui, Supprimer</button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .dashboard-content {
        animation: fadeIn 0.5s ease-out;
        padding-bottom: 4rem;
    }

    /* Modal Styles */
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        animation: fadeIn 0.2s ease-out;
    }

    .modal-content {
        width: 90%;
        max-width: 500px;
        padding: 2rem;
        border-radius: 16px;
        background: var(--dark-bg);
        border: 1px solid var(--glass-border);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .btn-cancel {
        background: transparent;
        border: 1px solid var(--glass-border);
        color: var(--grey-text);
        padding: 0.5rem 1rem;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 500;
    }

    .btn-cancel:hover {
        color: var(--white);
        border-color: var(--grey-text);
    }

    .btn-delete-confirm {
        background: #DC2626;
        border: none;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
    }

    .btn-delete-confirm:hover {
        background: #EF4444;
    }

    .flex {
        display: flex;
    }

    .justify-end {
        justify-content: flex-end;
    }

    .gap-4 {
        gap: 1rem;
    }


    .header-panel {
        padding: 2rem;
        background: linear-gradient(135deg, rgba(50, 74, 95, 0.4) 0%, rgba(12, 24, 33, 0.4) 100%);
        border-radius: 16px;
    }

    .glass-panel-message {
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.03);
    }

    .mb-8 {
        margin-bottom: 2rem;
    }

    .mb-6 {
        margin-bottom: 1.5rem;
    }

    .mb-2 {
        margin-bottom: 0.5rem;
    }

    .text-3xl {
        font-size: 1.875rem;
    }

    .text-xl {
        font-size: 1.25rem;
    }

    .font-bold {
        font-weight: 700;
    }

    .text-gray-400 {
        color: var(--grey-text);
    }

    .text-white {
        color: var(--white);
    }

    .col-span-full {
        grid-column: 1 / -1;
    }

    .text-center {
        text-align: center;
    }

    .p-8 {
        padding: 2rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
    }

    .events-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .glass-card {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s, background 0.2s;
        cursor: default;
        position: relative;
    }

    /* Stats Card Specifics */
    .stats-grid .glass-card {
        min-height: 160px;
    }

    .glass-card:hover {
        background: rgba(255, 255, 255, 0.08);
    }

    .glass-card.action-card {
        cursor: pointer;
        border: 1px dashed var(--charcoal-blue);
    }

    .glass-card.action-card:hover {
        border-color: var(--lavender);
        transform: translateY(-4px);
    }

    .glass-card h3 {
        margin: 0 0 0.5rem 0;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--grey-text);
    }

    .stats-grid .glass-card .value {
        font-size: 3rem;
        font-weight: 700;
        background: linear-gradient(135deg, var(--white) 0%, var(--lavender) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .btn-create {
        background: transparent;
        border: none;
        color: var(--lavender);
        font-weight: 600;
        font-size: 1.1rem;
        cursor: pointer;
        pointer-events: none;
    }
</style>

@code {
    private bool showCreateModal = false;
    private List<Event>? events;
    private Event? eventToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadEvents();
    }

    private async Task LoadEvents()
    {
        if (DemoDataService.IsInDemoMode)
        {
            // En mode démo, charger depuis le service qui utilise StaticDemoRepository
            events = (await DemoDataService.GetDemoEventsAsync()).OrderByDescending(e => e.Date).ToList();
        }
        else
        {
            // En mode normal, charger depuis la base de données
            using var context = await DbFactory.CreateDbContextAsync();
            events = await context.Events.OrderByDescending(e => e.Date).ToListAsync();
        }
    }

    private void GoToCreate()
    {
        showCreateModal = true;
    }

    private void HandleEditEvent(Event evt)
    {
        // TODO: Naviguer vers la page d'édition d'événement
        Navigation.NavigateTo($"event/{evt.Slug}/edit");
    }

    private void HandleAnalyzeEvent(Event evt)
    {
        // Naviguer vers la page de métriques
        Navigation.NavigateTo($"event/{evt.Slug}/metrics");
    }

    private void HandleGenerateEvent(Event evt)
    {
        // Naviguer vers la génération PDF
        Navigation.NavigateTo($"event/{evt.Slug}/pdf-customize");
    }

    private void HandleDeleteEvent(Event evt)
    {
        eventToDelete = evt;
    }

    private void HandleBulkAnalyze()
    {
        // TODO: Analyser les événements sélectionnés
        Console.WriteLine("Bulk analyze triggered");
    }

    private void HandleBulkDelete()
    {
        // TODO: Afficher une confirmation avant suppression en masse
        Console.WriteLine("Bulk delete triggered");
    }

    private void CancelDelete()
    {
        eventToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (eventToDelete == null) return;

        using var context = await DbFactory.CreateDbContextAsync();
        var evt = await context.Events.FindAsync(eventToDelete.Id);
        if (evt != null)
        {
            context.Events.Remove(evt);
            await context.SaveChangesAsync();
        }

        eventToDelete = null;
        await LoadEvents();
    }

    private async Task HandleEventCreated()
    {
        await LoadEvents();
        StateHasChanged();
    }
}