@page "/"
@rendermode RenderMode.InteractiveServer
@using SponsorPulse.Domain.Entities
@using SponsorPulse.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@inject NavigationManager Navigation
@inject IDbContextFactory<SponsorPulseDbContext> DbFactory

<PageTitle>Dashboard - SponsorPulse</PageTitle>

<div class="dashboard-content fade-in">
    <div class="glass-panel header-panel mb-8">
        <h1 class="text-3xl font-bold mb-2">Bienvenue sur SponsorPulse</h1>
        <p class="text-gray-400">Générez vos rapports sponsors professionnels en quelques clics.</p>
    </div>

    <div class="stats-grid mb-8">
        <div class="glass-card">
            <h3>Événements</h3>
            <div class="value">@(events?.Count ?? 0)</div>
        </div>
        <div class="glass-card">
            <h3>Rapports</h3>
            <div class="value">0</div>
        </div>
        <div class="glass-card action-card" @onclick="GoToCreate">
            <button class="btn-create">+ Créer un événement</button>
        </div>
    </div>

    <h2 class="text-xl font-bold text-white mb-6">Vos Événements</h2>

    <div class="events-grid">
        @if (events == null)
        {
            <div class="text-gray-400">Chargement...</div>
        }
        else if (!events.Any())
        {
            <div class="glass-panel text-center p-8 text-gray-400 col-span-full">
                Aucun événement pour le moment.
            </div>
        }
        else
        {
            @foreach (var evt in events)
            {
                <div class="glass-card event-card relative">
                    <button class="top-left-action" title="Options" @onclick="() => ToggleOptions(evt.Id)">
                        <span class="icon-dots"></span>
                    </button>

                    @if (optionsMenuOpenId == evt.Id)
                    {
                        <div class="options-menu">
                            <button class="menu-item delete" @onclick="() => ShowDeleteConfirmation(evt)">
                                Supprimer définitivement
                            </button>
                        </div>
                    }

                    <div class="card-content">
                        <h3 class="event-title">@evt.Name</h3>
                        <div class="event-meta">
                            <span class="meta-label">Date</span>
                            <span class="meta-value">@evt.Date.ToShortDateString()</span>
                        </div>
                    </div>

                    <button class="btn-access" @onclick="() => NavigateToEvent(evt.Slug)">
                        Accéder
                    </button>
                </div>
            }
        }
    </div>

    @if (showCreateModal)
    {
        <CreateEvent OnClose="@(() => showCreateModal = false)" OnCreated="HandleEventCreated" />
    }

    @if (eventToDelete != null)
    {
        <div class="modal-backdrop" @onclick="CancelDelete">
            <div class="modal-content glass-panel" @onclick:stopPropagation>
                <div class="mb-4">
                    <h2 class="text-xl font-bold text-white">Supprimer définitivement</h2>
                </div>

                <p class="text-gray-300 mb-6">
                    Etes vous sur de vouloir supprimer cet event <strong>@eventToDelete.Name</strong> ?
                </p>

                <div class="flex justify-end gap-4">
                    <button class="btn-cancel" @onclick="CancelDelete">Annuler</button>
                    <button class="btn-delete-confirm" @onclick="ConfirmDelete">Oui, Supprimer</button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* Previous styles remain */
    .dashboard-content {
        animation: fadeIn 0.5s ease-out;
        padding-bottom: 4rem;
    }

    /* Options Menu */
    .options-menu {
        position: absolute;
        top: 3.5rem;
        left: 1rem;
        background: var(--dark-bg);
        border: 1px solid var(--glass-border);
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
        z-index: 10;
        overflow: hidden;
        min-width: 180px;
    }

    .menu-item {
        display: block;
        width: 100%;
        text-align: left;
        padding: 0.75rem 1rem;
        background: transparent;
        border: none;
        color: var(--grey-text);
        cursor: pointer;
        font-size: 0.9rem;
        transition: all 0.2s;
    }

    .menu-item:hover {
        background: rgba(255, 255, 255, 0.05);
        color: var(--white);
    }

    .menu-item.delete:hover {
        background: rgba(239, 68, 68, 0.2);
        color: #F87171;
    }

    /* Modal Styles */
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        animation: fadeIn 0.2s ease-out;
    }

    .modal-content {
        width: 90%;
        max-width: 500px;
        padding: 2rem;
        border-radius: 16px;
        background: var(--dark-bg);
        border: 1px solid var(--glass-border);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .btn-cancel {
        background: transparent;
        border: 1px solid var(--glass-border);
        color: var(--grey-text);
        padding: 0.5rem 1rem;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 500;
    }

    .btn-cancel:hover {
        color: var(--white);
        border-color: var(--grey-text);
    }

    .btn-delete-confirm {
        background: #DC2626;
        border: none;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
    }

    .btn-delete-confirm:hover {
        background: #EF4444;
    }

    .flex {
        display: flex;
    }

    .justify-end {
        justify-content: flex-end;
    }

    .gap-4 {
        gap: 1rem;
    }


    .header-panel {
        padding: 2rem;
        background: linear-gradient(135deg, rgba(50, 74, 95, 0.4) 0%, rgba(12, 24, 33, 0.4) 100%);
        border-radius: 16px;
    }

    .glass-panel-message {
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.03);
    }

    .mb-8 {
        margin-bottom: 2rem;
    }

    .mb-6 {
        margin-bottom: 1.5rem;
    }

    .mb-2 {
        margin-bottom: 0.5rem;
    }

    .text-3xl {
        font-size: 1.875rem;
    }

    .text-xl {
        font-size: 1.25rem;
    }

    .font-bold {
        font-weight: 700;
    }

    .text-gray-400 {
        color: var(--grey-text);
    }

    .text-white {
        color: var(--white);
    }

    .col-span-full {
        grid-column: 1 / -1;
    }

    .text-center {
        text-align: center;
    }

    .p-8 {
        padding: 2rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
    }

    .events-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .glass-card {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s, background 0.2s;
        cursor: default;
        position: relative;
    }

    /* Stats Card Specifics */
    .stats-grid .glass-card {
        min-height: 160px;
    }

    /* Event Card Specifics */
    .event-card {
        align-items: flex-start;
        justify-content: space-between;
        min-height: 220px;
    }

    .glass-card:hover {
        background: rgba(255, 255, 255, 0.08);
    }

    .glass-card.action-card {
        cursor: pointer;
        border: 1px dashed var(--charcoal-blue);
    }

    .glass-card.action-card:hover {
        border-color: var(--lavender);
        transform: translateY(-4px);
    }

    .glass-card h3 {
        margin: 0 0 0.5rem 0;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--grey-text);
    }

    .stats-grid .glass-card .value {
        font-size: 3rem;
        font-weight: 700;
        background: linear-gradient(135deg, var(--white) 0%, var(--lavender) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .event-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--white);
        margin: 0 0 1rem 0;
        line-height: 1.3;
        /* Truncate if too long */
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .card-content {
        width: 100%;
        margin-top: 1.5rem;
        /* Space for the top-left button */
        flex-grow: 1;
    }

    .event-meta {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding-bottom: 0.25rem;
    }

    .event-meta:last-child {
        border-bottom: none;
    }

    .meta-label {
        color: var(--grey-text);
    }

    .meta-value {
        color: var(--lavender);
        font-weight: 500;
    }

    .top-left-action {
        position: absolute;
        top: 1rem;
        left: 1rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }

    .top-left-action:hover {
        background: rgba(255, 255, 255, 0.15);
        border-color: var(--lavender);
    }

    .icon-dots {
        display: block;
        width: 4px;
        height: 4px;
        background: var(--grey-text);
        box-shadow: 5px 0 0 var(--grey-text), -5px 0 0 var(--grey-text);
        border-radius: 50%;
    }

    .btn-create {
        background: transparent;
        border: none;
        color: var(--lavender);
        font-weight: 600;
        font-size: 1.1rem;
        cursor: pointer;
        pointer-events: none;
    }

    .btn-access {
        width: 100%;
        margin-top: 1rem;
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid var(--accent-blue);
        color: #60A5FA;
        padding: 0.75rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-access:hover {
        background: var(--accent-blue);
        color: white;
    }
</style>

@code {
    private bool showCreateModal = false;
    private List<Event>? events;
    private Guid? optionsMenuOpenId;
    private Event? eventToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadEvents();
    }

    private async Task LoadEvents()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        events = await context.Events.OrderByDescending(e => e.Date).ToListAsync();
    }

    private void GoToCreate()
    {
        showCreateModal = true;
    }

    private void ToggleOptions(Guid eventId)
    {
        if (optionsMenuOpenId == eventId)
        {
            optionsMenuOpenId = null;
        }
        else
        {
            optionsMenuOpenId = eventId;
        }
    }

    private void ShowDeleteConfirmation(Event evt)
    {
        eventToDelete = evt;
        optionsMenuOpenId = null; // Close menu
    }

    private void CancelDelete()
    {
        eventToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (eventToDelete == null) return;

        using var context = await DbFactory.CreateDbContextAsync();
        var evt = await context.Events.FindAsync(eventToDelete.Id);
        if (evt != null)
        {
            context.Events.Remove(evt);
            await context.SaveChangesAsync();
        }

        eventToDelete = null;
        await LoadEvents();
    }

    private async Task HandleEventCreated()
    {
        await LoadEvents();
        StateHasChanged();
    }

    private void NavigateToEvent(string slug)
    {
        Navigation.NavigateTo($"event/{slug}");
    }
}