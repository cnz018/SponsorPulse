<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RenderComponentScripts>true</RenderComponentScripts>
  </PropertyGroup>

  <Target Name="BuildTailwind" BeforeTargets="AfterBuild">
    <Exec Command="npm run tailwind:build" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Cloudflare.NET.R2" Version="2.0.0" />
    <PackageReference Include="Humanizer" Version="2.14.1" />
    <PackageReference Include="LumexUI" Version="2.3.1" />
    <PackageReference Include="MailKit" Version="4.9.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.3" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
  </ItemGroup>

</Project>
